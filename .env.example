# Шаблон змінних середовища. Скопіюй у .env і заповни.
# У цьому файлі — ЛИШЕ назви й безпечні значення за замовчуванням. Жодних справжніх секретів.

APP_ENV=dev                      # dev | test | staging | prod

# Telegram — токен бота береш у @BotFather (секрет!)
TELEGRAM_BOT_TOKEN=
# HTTPS-адреса Mini App. У dev — адреса тунелю до `pnpm -C web dev`
MINI_APP_URL=https://dramorr.github.io/domovyk/app/

# Перші адміністратори — Telegram ID через кому (дізнатись свій: /whoami у боті)
ADMIN_TELEGRAM_IDS=

# Версії документів, з якими погоджуються при реєстрації (FR-USR-1). Нова версія — повторна згода
TERMS_VERSION=2026-11-draft
PRIVACY_VERSION=2026-11-draft

# База й Redis (локальний Docker Compose)
DATABASE_URL=postgresql+asyncpg://domovyk:domovyk@localhost:5432/domovyk
REDIS_URL=redis://localhost:6379/0
BOT_FSM_STORAGE=redis            # memory — якщо Redis ще не запущено (dev без Docker)

# Тунель для dev (docs/TUNNEL.md)
NGROK_DOMAIN=                    # xxx.ngrok-free.dev з dashboard.ngrok.com → Domains
NGROK_AUTHTOKEN=                 # dashboard.ngrok.com → Your Authtoken (секрет!)
NGROK_PATH=                      # шлях до ngrok.exe, якщо його не знаходить (порожньо — шукаємо самі)

# API для Mini App
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=https://dramorr.github.io,http://localhost:5173
INIT_DATA_MAX_AGE_SECONDS=86400

# Криптографія (core/crypto.py) — згенеруй власні, не копіюй з прикладів (секрети!)
HMAC_SECRET=                     # uv run python -c "import secrets; print(secrets.token_hex(32))"
FERNET_KEY=                      # uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# Геокодер адрес (ADR 0002): nominatim — OpenStreetMap без ключа; manual — без мережі
GEOCODER=nominatim
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Сховище файлів (папка не в git). Документи власності шифруються FERNET_KEY
STORAGE_DIR=storage
OWNERSHIP_DOC_MAX_MB=10
OWNERSHIP_DOC_RETENTION_DAYS=30

# Рівні заповненості анкети об'єкта, % (ADR 0003)
PROFILE_MEDIUM_FROM=40
PROFILE_HIGH_FROM=75
# Договори (ADR 0010): кожен підпис підтверджує модератор, поки немає криптоперевірки
CONTRACTS_REQUIRE_MODERATOR=true
DIIA_SIGN_URL=https://id.gov.ua/sign
# PDF на Windows: тека з DLL Pango з MSYS2 (на Linux не потрібно)
WEASYPRINT_DLL_DIRECTORIES=
# Типове місто — код із довідника cities (ADR 0008)
DEFAULT_CITY=lviv
# Скільки живих оренд одночасно може мати відповідальний орендар (більше — заблоковано)
TENANT_MAX_OPEN_LEASES=2
# Мінімум заповненості анкети для оголошення; від нього ж стартує фільтр пошуку
LISTING_MIN_COMPLETENESS=40

# Dev-прапорці (лише APP_ENV=dev; інакше застосунок не стартує)
DEV_SKIP_OWNERSHIP_CHECK=false
