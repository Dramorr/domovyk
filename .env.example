# Шаблон змінних середовища. Скопіюй у .env і заповни.
# У цьому файлі — ЛИШЕ назви й безпечні значення за замовчуванням. Жодних справжніх секретів.

APP_ENV=dev                      # dev | staging | prod

# Telegram — токен бота береш у @BotFather
TELEGRAM_BOT_TOKEN=

# База й Redis (локальний Docker Compose)
DATABASE_URL=postgresql+asyncpg://domovyk:domovyk@localhost:5432/domovyk
REDIS_URL=redis://localhost:6379/0

# Криптографія (core/crypto.py) — згенеруй власні, не копіюй з прикладів
HMAC_SECRET=                     # python -c "import secrets; print(secrets.token_hex(32))"
FERNET_KEY=                      # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# Dev-прапорці (лише APP_ENV=dev; інакше застосунок не стартує)
DEV_SKIP_OWNERSHIP_CHECK=false
